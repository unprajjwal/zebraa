{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zebraa",
  "version": "0.0.1",
  "identifier": "com.zebraa.app",
  "build": {
    "beforeDevCommand": "pnpm --filter zebraa-desktop exec vite",
    "beforeBuildCommand": "pnpm --filter zebraa-desktop exec vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/desktop/dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Zebraa",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
